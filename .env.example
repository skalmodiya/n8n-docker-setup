# Copy this file to .env and fill in real values: cp .env.example .env

# --- ngrok ---
# Get from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=3269Emuki2w712GoDrX4x74y02M_44tqwSze9FtHX62Pz1JAV
# Your reserved ngrok domain (e.g. virtually-workable-fly.ngrok-free.app)
NGROK_DOMAIN=virtually-workable-fly.ngrok-free.app

# --- Postgres ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=password
POSTGRES_DB=n8n

# --- n8n encryption key ---
# IMPORTANT: set this ONCE and keep it. Changing it invalidates stored credentials.
# Generate one with: openssl rand -hex 32   (or any 32+ char random string)
N8N_ENCRYPTION_KEY=0cac09d0400968103048e3c2f54a6617a9412e401118d665b1bda84d91185d89

# --- Qdrant ---
# API key the n8n Qdrant credential will use. Leave blank to run Qdrant unauthenticated (not recommended).
# Generate one with: openssl rand -hex 32
QDRANT_API_KEY=0cac09d0400968103048e3c2f54a6617a9412e401118d665b1bda84d91185d89
# Optional: separate read-only key for browsing the dashboard. Leave blank to skip.
QDRANT_READ_ONLY_API_KEY=

# --- Timezone ---
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin
